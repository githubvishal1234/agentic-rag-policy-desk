# Copy this file to .env (same folder) and fill in what you need:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
# .env is in .gitignore, so your keys are never committed.
# Restart the backend after changing it.

# ---------------------------------------------------------------------------
# 1. AI model: pick ONE option and fill in its lines.
# ---------------------------------------------------------------------------

# Option A - Claude (default; best citations). Key: https://platform.claude.com
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5            # optional: another Claude model

# Option B - OpenAI. Key: https://platform.openai.com/api-keys
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5-mini
# LLM_API_KEY=sk-...

# Option C - Google Gemini (has a free tier). Key: https://aistudio.google.com/apikey
# LLM_PROVIDER=openai
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key

# Option D - Groq (fast, free tier). Key: https://console.groq.com/keys
# LLM_PROVIDER=openai
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...

# Option E - Ollama (free, runs on your computer, no key). https://ollama.com
# First run:  ollama pull qwen2.5:7b
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5:7b
# LLM_BASE_URL=http://localhost:11434/v1

# ---------------------------------------------------------------------------
# 2. Sign-in (optional). Leave both empty to keep the app open.
# ---------------------------------------------------------------------------
POLICY_DESK_PASSWORD=
POLICY_DESK_ADMIN_PASSWORD=
# Signs session cookies. Set any long random text, or everyone is signed out
# whenever the server restarts.
POLICY_DESK_SECRET=
# Set to 1 when the site is served over HTTPS.
# POLICY_DESK_HTTPS_ONLY=1
